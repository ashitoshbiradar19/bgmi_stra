  'Starline Esports', 'Pro Esports', 'Alpha Esports', 'Crimson Tactical', 'Ozone Esports',
  'Hyper Esports', 'Magnum Esports', 'Infinity Esports', 'Byte Esports', 'Cipher Esports',
  'Nova Esports', 'Zenith Esports', 'Apex Predators', 'Stellar Esports', 'Vortex Esports',
]

// Generate the invitee entries with a deterministic palette. Assign a rough global
// ordinal rank starting after the headline 22.
const rest = invitees.map((name, i) => {
  const short = name
    .split(/[\sx]+/)
    .map((w) => w[0])
    .join('')
    .replace(/[^A-Z0-9]/gi, '')
    .slice(0, 4)
    .toUpperCase() || name.slice(0, 4).toUpperCase()
  const { color, color2 } = PAL[i % PAL.length]
  return { id: name.toLowerCase().replace(/[^a-z0-9]+/g, ''), name, short, rank: 23 + i, color, color2, event: 'BMPS/BGIS/BGMS 2026' }
})

export const TEAMS = [...headline, ...rest]

export const TEAM_MAP = Object.fromEntries(TEAMS.map((t) => [t.id, t]))

export function getTeam(id) {
  return TEAM_MAP[id] || null
}