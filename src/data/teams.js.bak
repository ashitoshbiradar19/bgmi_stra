// BGMI competitive teams — 100+ squads from official & unofficial Krafton-sanctioned
// events 2025–2026 (BGIS, BMPS, BGMS, India Rising Series). `rank` reflects official
// Global Points status where known; otherwise a roster-list ordinal.
// Each team carries brand colors for the map badge and an optional `logoUrl` (paste
// any public image URL to show the real logo in the panel & on the map).

// Deterministic palette fallback for teams without a published brand color.
const PAL = [
  ['#f43f5e', '#1c1420'],
  ['#38bdf8', '#0c1a2e'],
  ['#34d399', '#062820'],
  ['#facc15', '#29210a'],
  ['#a78bfa', '#1a1230'],
  ['#fb923c', '#241409'],
  ['#2dd4bf', '#05201c'],
  ['#e879f9', '#24102b'],
  ['#f472b6', '#261019'],
  ['#818cf8', '#0f1230'],
]

function S(name, short, event, seed) {
  const [color, color2] = PAL[seed % PAL.length]
  return { id: name.toLowerCase().replace(/[^a-z0-9]+/g, ''), name, short, color, color2, event }
}

